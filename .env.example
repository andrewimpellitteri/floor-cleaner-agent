# Copy to .env at the repo root and fill in. .env is gitignored; this file is not.
# scripts/runpod_launch.py reads the first of: --env-file, ./.env,
# ~/.config/floorclean/.env. Anything already exported wins over all of them,
# so CI can inject these with no file at all.

# --- required for a launch -------------------------------------------------
RUNPOD_API_KEY=
S3_BUCKET=                 # e.g. my-bucket/floorclean
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- optional --------------------------------------------------------------
S3_ENDPOINT_URL=           # only for non-AWS S3 (R2, B2, MinIO)
WANDB_API_KEY=             # omit to train with no run tracking at all
GH_PAT=                    # only needed if you fork this repo private
